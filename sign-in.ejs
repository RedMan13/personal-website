<!TEMPLATE /cardpage.html>
<head>
    <title>Sign In</title>
    <%
        const meta = new URLSearchParams(req.body?.toString?.());
        const hasSubmitted = !!req.body?.length;
        const token = hasSubmitted &&
            meta.get('username').length > 1 && 
            await users.getToken(meta.get('username').slice(0, 64), meta.get('password').slice(0, 64))
                .catch(err => (console.log(err), err));
        if (typeof token === 'string')
            res.header('Set-Cookie', `token=${escape(token)}; Secure; HttpOnly; Max-Age=${400 * 24 * 60 * 60}`);
    %>
    <style>
        p {
            margin: 0px;
            margin-top: 6px;
        }
        form {
            padding: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .inputs-wrapper {
            width: 45%;
            margin-bottom: 1em;
        }
        .text-input {
            width: 100%;
            padding: .35em;
            border-radius: .4em;
        }
        input[type=submit] {
            padding: .1em .4em !important;
            border-radius: .4em;
        }
    </style>
</head>
<body>
    <% if (!hasSubmitted) { %>
        <form method="post">
            <div class="inputs-wrapper">
                <p>Username:</p>
                <input class="text-input" type="text" name="username" minlength="2" maxlength="64" required placeholder="John Sigma">
                <p>Password:</p>
                <input class="text-input" type="password" name="password" minlength="8" maxlength="64" required>
                <p>Dont have an account yet? <a href="/sign-up">Make an account</a></p>
            </div>
            <input type="submit" name="login" value="Log in">
        </form>
    <% } else if (token instanceof Error && !token.message.includes('banned')) { %>
        <p>Oops! looks like that account info wasnt correct. Maybe you spelled something wrong? Make sure you already have an account before you try signing into it.</p>
    <% } else if (token instanceof Error) { %>
        <p><%= token.message %></p>
    <% } else { %>
        <p>Logged in!</p>
    <% } %>
</body>