<!TEMPLATE /cardpage.html>
<head>
    <title>Sign Up</title>
    <%
        const meta = new URLSearchParams(req.body?.toString?.());
        const hasSubmitted = !!req.body?.length;
        const registered = hasSubmitted &&
            meta.get('username').length > 1 && 
            await users.register(meta.get('username').slice(0, 64), meta.get('password').slice(0, 64), meta.get('email').slice(0, 128));
        const token = registered &&
            await users.getToken(meta.get('username').slice(0, 64), meta.get('password').slice(0, 64))
                .catch(err => err);
        if (typeof token === 'string')
            res.header('Set-Cookie', `token=${escape(token)}; Secure; HttpOnly; Max-Age=${400 * 24 * 60 * 60}`);
    %>
    <style>
        p {
            margin: 0px;
            margin-top: 6px;
        }
        form {
            padding: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .inputs-wrapper {
            width: 45%;
            margin-bottom: 1em;
        }
        .text-input {
            width: 100%;
            padding: .35em;
            border-radius: .4em;
        }
        input[type=submit] {
            padding: .1em .4em !important;
            border-radius: .4em;
        }
    </style>
</head>
<body>
    <% if (!hasSubmitted) { %>
        <form method="post">
            <div class="inputs-wrapper"> 
                <p>Username:</p>
                <input class="text-input" type="text" name="username" minlength="2" maxlength="64" required placeholder="John Sigma">
                <p>Password:</p>
                <input class="text-input" type="password" name="password" minlength="8" maxlength="64" required>
                <p>Email:</p>
                <input class="text-input" type="email" name="email" maxlength="128" required>
            </div>
            <input type="submit" value="Sign up">
        </form>
    <% } else if (!token || token instanceof Error) { %>
        <p>Oops! Looks like something wasnt right. Maybe the username is already taken?</p>
    <% } else {
        res.redirect('/settings');
    } %>
</body>